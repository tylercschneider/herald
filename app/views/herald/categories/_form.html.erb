<%= form_with(model: category, url: category.persisted? ? herald.post_category_path(category) : herald.post_categories_path, class: "space-y-6") do |form| %>
  <% if category.errors.any? %>
    <%= ui_alert(message: category.errors.full_messages.to_sentence, type: :error) %>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_field :name, class: Keystone::Ui::InputComponent::BASE_CLASSES, autofocus: true %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_area :description, rows: 2, class: Keystone::Ui::TextareaComponent::BASE_CLASSES %>
  </div>

  <div>
    <%= form.label :position, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.number_field :position, class: Keystone::Ui::InputComponent::BASE_CLASSES %>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel", herald.post_categories_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300" %>
    <%= form.submit class: Keystone::Ui::ButtonComponent.new(label: "").classes + " cursor-pointer" %>
  </div>
<% end %>
