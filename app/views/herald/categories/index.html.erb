<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: "Blog Categories", subtitle: "Organize your blog posts") do |header|
    header.action do
      ui_button(label: "New Category", href: herald.new_post_category_path)
    end
  end %>

  <div class="mt-8">
    <% if @categories.any? %>
      <ul class="divide-y divide-gray-200 dark:divide-zinc-700">
        <% @categories.each do |category| %>
          <li class="flex items-center justify-between py-4">
            <div>
              <span class="text-gray-900 dark:text-white"><%= category.name %></span>
              <% if category.description.present? %>
                <p class="text-sm text-gray-500 dark:text-gray-400"><%= category.description %></p>
              <% end %>
            </div>
            <div class="flex gap-2">
              <%= link_to "Edit", herald.edit_post_category_path(category), class: herald_accent_inline_link_classes %>
              <%= button_to "Delete", herald.post_category_path(category), method: :delete, class: "text-sm text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300", data: { turbo_confirm: "Delete #{category.name}?" } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400">No categories yet.</p>
      </div>
    <% end %>
  </div>
<% end %>
