<%= ui_page(max_width: :md, top_offset: :lg) do %>
  <div class="text-center mb-12">
    <p class="text-sm font-medium <%= herald_accent(:text) %> <%= herald_accent(:dark_text) %> mb-2">Category</p>
    <h1 class="text-4xl font-bold mb-4"><%= @category.name %></h1>
    <% if @category.description.present? %>
      <p class="<%= herald_surface(:body) %> leading-relaxed text-xl"><%= @category.description %></p>
    <% end %>
  </div>

  <% if @posts.any? %>
    <div class="space-y-8">
      <% @posts.each do |post| %>
        <article>
          <%= ui_panel(padding: :lg, radius: :xl) do %>
            <%= link_to herald.blog_post_path(post.slug), class: "block group" do %>
              <h2 class="text-2xl font-semibold mb-2 <%= herald_title_hover_classes %>"><%= post.title %></h2>
            <% end %>
            <div class="flex items-center gap-3 text-sm <%= herald_surface(:body) %> mb-3">
              <span><%= post.user.name %></span>
              <span>&middot;</span>
              <time datetime="<%= post.published_at.iso8601 %>"><%= post.published_at.strftime("%B %-d, %Y") %></time>
            </div>
            <% if post.excerpt.present? %>
              <p class="<%= herald_surface(:muted) %>"><%= post.excerpt %></p>
            <% end %>
          <% end %>
        </article>
      <% end %>
    </div>

    <%== @pagy.series_nav %>
  <% else %>
    <p class="text-center <%= herald_surface(:body) %>">No posts in this category yet.</p>
  <% end %>

  <div class="mt-12 pt-8 border-t <%= herald_surface(:card_border) %>">
    <%= link_to "&larr; Back to Blog".html_safe, herald.blog_path, class: herald_accent_link_classes %>
  </div>
<% end %>
