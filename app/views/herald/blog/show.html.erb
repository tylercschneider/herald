<link rel="canonical" href="<%= herald.blog_post_url(@post.slug) %>">

<meta property="og:title" content="<%= @post.title %>">
<meta property="og:type" content="article">
<meta property="og:url" content="<%= herald.blog_post_url(@post.slug) %>">
<meta property="og:description" content="<%= @post.meta_description.presence || @post.excerpt %>">
<% if @post.published_at.present? %>
<meta property="article:published_time" content="<%= @post.published_at.iso8601 %>">
<% end %>
<meta property="article:modified_time" content="<%= @post.updated_at.iso8601 %>">

<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= @post.title %>">
<meta name="twitter:description" content="<%= @post.meta_description.presence || @post.excerpt %>">

<script type="application/ld+json">
<%= raw({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": @post.title,
  "description": @post.meta_description.presence || @post.excerpt,
  "author": {"@type": "Person", "name": @post.user.name},
  "datePublished": @post.published_at&.iso8601,
  "dateModified": @post.updated_at.iso8601,
  "url": herald.blog_post_url(@post.slug)
}.compact.to_json) %>
</script>

<%= ui_page(max_width: :md, top_offset: :lg) do %>
  <article>
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4"><%= @post.title %></h1>
      <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
        <span><%= @post.user.name %></span>
        <% if @post.published_at.present? %>
          <span>&middot;</span>
          <time datetime="<%= @post.published_at.iso8601 %>"><%= @post.published_at.strftime("%B %-d, %Y") %></time>
        <% end %>
        <% if @post.categories.any? %>
          <span>&middot;</span>
          <% @post.categories.each do |category| %>
            <%= link_to category.name, herald.blog_category_path(category.slug), class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
          <% end %>
        <% end %>
        <% if @post.tags.any? %>
          <span>&middot;</span>
          <% @post.tags.each do |tag| %>
            <%= link_to tag.name, herald.blog_tag_path(tag.slug), class: "text-blue-600 hover:underline dark:text-blue-400" %>
          <% end %>
        <% end %>
      </div>
    </header>

    <% if @post.featured_image.attached? %>
      <div class="mb-8">
        <%= image_tag @post.featured_image, class: "w-full rounded-lg", loading: "lazy" %>
      </div>
    <% end %>

    <div class="prose prose-lg dark:prose-invert max-w-none">
      <%= @post.body %>
    </div>
  </article>

  <% related = @post.related_posts %>
  <% if related.any? %>
    <%= ui_section(title: "Related Posts", spacing: :lg) do %>
      <%= ui_grid(cols: { default: 1, sm: 2, lg: 3 }, gap: :md) do %>
        <% related.each do |post| %>
          <%= ui_card(title: post.title, summary: post.excerpt.present? ? truncate(post.excerpt, length: 120) : "", link: herald.blog_post_path(post.slug)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="mt-12 pt-8 border-t border-gray-200 dark:border-zinc-700">
    <%= link_to "&larr; Back to Blog".html_safe, herald.blog_path, class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
  </div>
<% end %>
