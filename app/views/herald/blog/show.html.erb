<link rel="canonical" href="<%= blog_post_url(@post.slug) %>">

<meta property="og:title" content="<%= @post.title %>">
<meta property="og:type" content="article">
<meta property="og:url" content="<%= blog_post_url(@post.slug) %>">
<meta property="og:description" content="<%= @post.meta_description.presence || @post.excerpt %>">
<% if @post.published_at.present? %>
<meta property="article:published_time" content="<%= @post.published_at.iso8601 %>">
<% end %>
<meta property="article:modified_time" content="<%= @post.updated_at.iso8601 %>">

<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= @post.title %>">
<meta name="twitter:description" content="<%= @post.meta_description.presence || @post.excerpt %>">

<script type="application/ld+json">
<%= raw({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": @post.title,
  "description": @post.meta_description.presence || @post.excerpt,
  "author": {"@type": "Person", "name": @post.user.name},
  "datePublished": @post.published_at&.iso8601,
  "dateModified": @post.updated_at.iso8601,
  "url": blog_post_url(@post.slug)
}.compact.to_json) %>
</script>

<div class="py-16 max-w-3xl m-auto px-4">
  <article>
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4"><%= @post.title %></h1>
      <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
        <span><%= @post.user.name %></span>
        <% if @post.published_at.present? %>
          <span>&middot;</span>
          <time datetime="<%= @post.published_at.iso8601 %>"><%= @post.published_at.strftime("%B %-d, %Y") %></time>
        <% end %>
        <% if @post.categories.any? %>
          <span>&middot;</span>
          <% @post.categories.each do |category| %>
            <%= link_to category.name, blog_category_path(category.slug), class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
          <% end %>
        <% end %>
        <% if @post.tags.any? %>
          <span>&middot;</span>
          <% @post.tags.each do |tag| %>
            <%= link_to tag.name, blog_tag_path(tag.slug), class: "text-blue-600 hover:underline dark:text-blue-400" %>
          <% end %>
        <% end %>
      </div>
    </header>

    <% if @post.featured_image.attached? %>
      <div class="mb-8">
        <%= image_tag @post.featured_image, class: "w-full rounded-lg" %>
      </div>
    <% end %>

    <div class="prose prose-lg dark:prose-invert max-w-none">
      <%= @post.body %>
    </div>
  </article>

  <% related = @post.related_posts %>
  <% if related.any? %>
    <div class="mt-12 pt-8 border-t border-gray-200 dark:border-zinc-700">
      <h2 class="text-2xl font-bold mb-6">Related Posts</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% related.each do |post| %>
          <div class="rounded-lg border border-gray-200 dark:border-zinc-700 p-4">
            <h3 class="font-semibold mb-2">
              <%= link_to post.title, blog_post_path(post.slug), class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
            </h3>
            <% if post.excerpt.present? %>
              <p class="text-sm text-gray-600 dark:text-gray-400"><%= truncate(post.excerpt, length: 120) %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-12 pt-8 border-t border-gray-200 dark:border-zinc-700">
    <%= link_to "&larr; Back to Blog".html_safe, blog_path, class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
  </div>
</div>
