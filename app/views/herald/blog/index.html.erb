<div class="py-16 max-w-3xl m-auto px-4">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold mb-4">Blog</h1>
    <p class="text-gray-700 dark:text-gray-200 leading-relaxed text-xl">Latest articles and insights</p>
  </div>

  <%= form_tag blog_path, method: :get, class: "mb-8 flex gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Search posts...", autocomplete: "off", class: "flex-1 rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600 dark:text-white" %>
    <%= submit_tag "Search", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
  <% end %>

  <% if @posts.any? %>
    <div class="space-y-8">
      <% @posts.each do |post| %>
        <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:bg-zinc-900 dark:border-zinc-700">
          <%= link_to blog_post_path(post.slug), class: "block group" do %>
            <h2 class="text-2xl font-semibold mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400"><%= post.title %></h2>
          <% end %>
          <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400 mb-3">
            <span><%= post.user.name %></span>
            <span>&middot;</span>
            <time datetime="<%= post.published_at.iso8601 %>"><%= post.published_at.strftime("%B %-d, %Y") %></time>
            <% if post.categories.any? %>
              <span>&middot;</span>
              <% post.categories.each do |category| %>
                <%= link_to category.name, blog_category_path(category.slug), class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
              <% end %>
            <% end %>
          </div>
          <% if post.excerpt.present? %>
            <p class="text-gray-600 dark:text-gray-400"><%= post.excerpt %></p>
          <% end %>
        </article>
      <% end %>
    </div>

    <%== @pagy.series_nav %>
  <% else %>
    <p class="text-center text-gray-500 dark:text-gray-400">No posts yet. Check back soon!</p>
  <% end %>
</div>
