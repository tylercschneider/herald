<div class="py-16 max-w-3xl m-auto px-4">
  <div class="text-center mb-12">
    <p class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-2">Tag</p>
    <h1 class="text-4xl font-bold mb-4"><%= @tag.name %></h1>
  </div>

  <% if @posts.any? %>
    <div class="space-y-8">
      <% @posts.each do |post| %>
        <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:bg-zinc-900 dark:border-zinc-700">
          <%= link_to herald.blog_post_path(post.slug), class: "block group" do %>
            <h2 class="text-2xl font-semibold mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400"><%= post.title %></h2>
          <% end %>
          <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400 mb-3">
            <span><%= post.user.name %></span>
            <span>&middot;</span>
            <time datetime="<%= post.published_at.iso8601 %>"><%= post.published_at.strftime("%B %-d, %Y") %></time>
          </div>
          <% if post.excerpt.present? %>
            <p class="text-gray-600 dark:text-gray-400"><%= post.excerpt %></p>
          <% end %>
        </article>
      <% end %>
    </div>

    <%== @pagy.series_nav %>
  <% else %>
    <p class="text-center text-gray-500 dark:text-gray-400">No posts with this tag yet.</p>
  <% end %>

  <div class="mt-12 pt-8 border-t border-gray-200 dark:border-zinc-700">
    <%= link_to "&larr; Back to Blog".html_safe, herald.blog_path, class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
  </div>
</div>
