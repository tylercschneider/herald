<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div>
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Blog Posts</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage your blog content</p>
      </div>
      <%= link_to "New Post", herald.new_post_path, class: "rounded-md bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 min-h-[44px] inline-flex items-center" %>
    </div>
  </div>

  <%= form_tag herald.posts_path, method: :get, class: "mt-6 flex gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Search posts...", autocomplete: "off", class: "flex-1 rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600 dark:text-white" %>
    <%= select_tag :category, options_for_select([["All Categories", ""]] + @categories.map { |c| [c.name, c.id] }, params[:category]), class: "rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600 dark:text-white" %>
    <%= submit_tag "Search", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
  <% end %>

  <div class="mt-8">
    <% if @posts.any? %>
      <ul class="divide-y divide-gray-200 dark:divide-zinc-700">
        <% @posts.each do |post| %>
          <li class="py-4">
            <div class="flex items-center justify-between">
              <div>
                <%= link_to herald.post_path(post), class: "text-gray-900 dark:text-white font-medium hover:text-indigo-600 dark:hover:text-indigo-400" do %>
                  <%= post.title %>
                <% end %>
                <div class="flex items-center gap-2 mt-1 text-sm text-gray-500 dark:text-gray-400">
                  <% if post.pinned? %>
                    <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-amber-600/20 ring-inset dark:bg-amber-500/10 dark:text-amber-400 dark:ring-amber-500/20">Pinned</span>
                  <% end %>
                  <% if post.published? %>
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset dark:bg-green-500/10 dark:text-green-400 dark:ring-green-500/20">Published</span>
                  <% elsif post.scheduled? %>
                    <span class="inline-flex items-center rounded-full bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-purple-600/20 ring-inset dark:bg-purple-500/10 dark:text-purple-400 dark:ring-purple-500/20">Scheduled</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset dark:bg-gray-400/10 dark:text-gray-400 dark:ring-gray-400/20">Draft</span>
                  <% end %>
                  <% if post.published_at.present? %>
                    <span><%= post.published_at.strftime("%B %-d, %Y") %></span>
                  <% end %>
                </div>
              </div>
              <div class="flex gap-2">
                <%= link_to "Edit", herald.edit_post_path(post), class: "text-sm text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300" %>
                <% if post.published? %>
                  <%= link_to "View", herald.blog_post_path(post.slug), class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300", target: "_blank" %>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>

      <%== @pagy.series_nav %>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400">No blog posts yet.</p>
        <p class="mt-2 text-sm text-gray-400 dark:text-gray-500">
          Create your first post to get started.
        </p>
      </div>
    <% end %>
  </div>
</div>
