<%= ui_page do %>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white"><%= @post.title %></h1>
    <div class="flex items-center gap-3">
      <% if @post.published? %>
        <%= link_to "View on blog", blog_post_path(@post.slug), class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300", target: "_blank" %>
      <% end %>
      <%= link_to "Edit", edit_post_path(@post), class: "rounded-md bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 min-h-[44px] inline-flex items-center" %>
      <%= button_to "Delete", post_path(@post), method: :delete, class: "text-sm text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300", data: { turbo_confirm: "Delete this post?" } %>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:bg-zinc-900 dark:border-zinc-700">
    <div class="flex items-center gap-2 mb-4 text-sm text-gray-500 dark:text-gray-400">
      <% if @post.published? %>
        <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset dark:bg-green-500/10 dark:text-green-400 dark:ring-green-500/20">Published</span>
      <% else %>
        <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset dark:bg-gray-400/10 dark:text-gray-400 dark:ring-gray-400/20">Draft</span>
      <% end %>
      <span>by <%= @post.user.name %></span>
      <% if @post.published_at.present? %>
        <span>&middot;</span>
        <span><%= @post.published_at.strftime("%B %-d, %Y") %></span>
      <% end %>
    </div>

    <% if @post.excerpt.present? %>
      <p class="text-gray-600 dark:text-gray-400 italic mb-4"><%= @post.excerpt %></p>
    <% end %>

    <div class="prose prose-lg dark:prose-invert max-w-none">
      <%= @post.body %>
    </div>

    <% if @post.categories.any? %>
      <div class="mt-6 pt-4 border-t border-gray-200 dark:border-zinc-700">
        <span class="text-sm text-gray-500 dark:text-gray-400">Categories:</span>
        <% @post.categories.each do |category| %>
          <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-indigo-700/10 ring-inset dark:bg-indigo-400/10 dark:text-indigo-400 dark:ring-indigo-400/30 ml-1"><%= category.name %></span>
        <% end %>
      </div>
    <% end %>

    <% if @post.tags.any? %>
      <div class="mt-4 pt-4 border-t border-gray-200 dark:border-zinc-700">
        <span class="text-sm text-gray-500 dark:text-gray-400">Tags:</span>
        <% @post.tags.each do |tag| %>
          <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-blue-700/10 ring-inset dark:bg-blue-400/10 dark:text-blue-400 dark:ring-blue-400/30 ml-1"><%= tag.name %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
