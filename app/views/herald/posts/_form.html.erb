<%= form_with(model: post, url: post.persisted? ? herald.post_path(post) : herald.posts_path, class: "space-y-6") do |form| %>
  <% if post.errors.any? %>
    <%= ui_alert(message: post.errors.full_messages.to_sentence, type: :error) %>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_field :title, class: Keystone::Ui::InputComponent::BASE_CLASSES, autofocus: true %>
  </div>

  <div>
    <%= form.label :slug, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_field :slug, class: Keystone::Ui::InputComponent::BASE_CLASSES, placeholder: "auto-generated-from-title" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">URL-friendly identifier. Auto-generated from title if left blank.</p>
  </div>

  <div>
    <%= form.label :excerpt, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_area :excerpt, rows: 2, class: Keystone::Ui::TextareaComponent::BASE_CLASSES %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Short summary shown in blog listing and search results.</p>
  </div>

  <div>
    <%= form.label :body, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.rich_text_area :body, class: "mt-1" %>
  </div>

  <div>
    <%= form.label :meta_description, "Meta Description", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_area :meta_description, rows: 2, maxlength: 160, class: Keystone::Ui::TextareaComponent::BASE_CLASSES %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">For search engines. 140-160 characters recommended. Falls back to excerpt if blank.</p>
  </div>

  <div>
    <%= form.label :featured_image, "Featured Image", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <% if post.featured_image.attached? %>
      <div class="mt-2 mb-2">
        <%= image_tag post.featured_image, class: "max-h-48 rounded-lg" %>
      </div>
    <% end %>
    <%= form.file_field :featured_image, accept: "image/*", class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 dark:text-gray-400 dark:file:bg-indigo-900/50 dark:file:text-indigo-400" %>
  </div>

  <div>
    <%= form.label :tag_list, "Tags", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_field :tag_list, value: post.tag_list, class: Keystone::Ui::InputComponent::BASE_CLASSES, placeholder: "Ruby, Rails, JavaScript" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Comma-separated list of tags.</p>
  </div>

  <div>
    <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Categories</span>
    <% if Herald::Category.any? %>
      <div class="flex flex-wrap gap-3 mb-3">
        <% Herald::Category.ordered.each do |category| %>
          <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
            <%= form.check_box :category_ids, { multiple: true, checked: post.category_ids.include?(category.id) }, category.id, nil %>
            <%= category.name %>
          </label>
        <% end %>
      </div>
    <% end %>
    <%= form.text_field :new_category_name, class: Keystone::Ui::InputComponent::BASE_CLASSES, placeholder: "Add new category..." %>
  </div>

  <div>
    <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <%= form.check_box :pinned, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600" %>
      Pin this post (appears first in blog listing)
    </label>
  </div>

  <div>
    <%= form.label :status, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.select :status, Herald::Post.statuses.keys.map { |s| [s.titleize, s] }, {}, class: Keystone::Ui::InputComponent::BASE_CLASSES %>
  </div>

  <div>
    <%= form.label :published_at, "Publish Date", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.datetime_local_field :published_at, class: Keystone::Ui::InputComponent::BASE_CLASSES %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Set a future date with "Scheduled" status to auto-publish.</p>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel", herald.posts_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300" %>
    <%= form.submit class: Keystone::Ui::ButtonComponent::BASE_CLASSES + " " + Keystone::Ui::ButtonComponent::VARIANT_CLASSES[:primary] + " " + Keystone::Ui::ButtonComponent::SIZE_CLASSES[:md] + " cursor-pointer" %>
  </div>
<% end %>
