<%= form_with(model: post, url: post.persisted? ? post_path(post) : posts_path, class: "space-y-6") do |form| %>
  <% if post.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 dark:bg-red-900/20">
      <ul class="list-disc pl-5 text-sm text-red-700 dark:text-red-400">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600 dark:text-white sm:text-sm", autofocus: true %>
  </div>

  <div>
    <%= form.label :excerpt, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_area :excerpt, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600 dark:text-white sm:text-sm" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Short summary shown in blog listing and search results.</p>
  </div>

  <div>
    <%= form.label :body, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.rich_text_area :body, class: "mt-1" %>
  </div>

  <div>
    <%= form.label :meta_description, "Meta Description", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_area :meta_description, rows: 2, maxlength: 160, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600 dark:text-white sm:text-sm" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">For search engines. 140-160 characters recommended. Falls back to excerpt if blank.</p>
  </div>

  <div>
    <%= form.label :tag_list, "Tags", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_field :tag_list, value: post.tag_list, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600 dark:text-white sm:text-sm", placeholder: "Ruby, Rails, JavaScript" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Comma-separated list of tags.</p>
  </div>

  <% if Herald::Category.any? %>
    <div>
      <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Categories</span>
      <div class="flex flex-wrap gap-3">
        <% Herald::Category.ordered.each do |category| %>
          <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
            <%= form.check_box :category_ids, { multiple: true, checked: post.category_ids.include?(category.id) }, category.id, nil %>
            <%= category.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div>
    <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <%= form.check_box :pinned, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600" %>
      Pin this post (appears first in blog listing)
    </label>
  </div>

  <div>
    <%= form.label :status, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.select :status, Herald::Post.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-zinc-800 dark:border-zinc-600 dark:text-white sm:text-sm" %>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel", posts_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300" %>
    <%= form.submit class: "rounded-md bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 min-h-[44px] inline-flex items-center cursor-pointer" %>
  </div>
<% end %>
